{
  "name": "claude-code-groups",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.5.1",
  "publisher": "zaza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravencs2hs-del/claude-code-vscode-enhancer.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "sessions",
    "usage limits",
    "folders"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeGroups",
          "title": "%view.title%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "claudeGroups": [
        {
          "type": "webview",
          "id": "claudeGroups.sessions",
          "name": "%view.title%",
          "icon": "media/activity.svg",
          "contextualTitle": "%view.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeGroups.newSession",
        "title": "%command.newSession%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "claudeGroups.group.newSession",
        "title": "%command.group.newSession%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.newGroup",
        "title": "%command.newGroup%",
        "category": "%category%",
        "icon": "$(new-folder)"
      },
      {
        "command": "claudeGroups.refresh",
        "title": "%command.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeGroups.collapseAll",
        "title": "%command.collapseAll%",
        "category": "%category%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "claudeGroups.expandAll",
        "title": "%command.expandAll%",
        "category": "%category%",
        "icon": "$(expand-all)"
      },
      {
        "command": "claudeGroups.focusSearch",
        "title": "%command.focusSearch%",
        "category": "%category%",
        "icon": "$(search)"
      },
      {
        "command": "claudeGroups.importFromClaude",
        "title": "%command.importFromClaude%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.openSettings",
        "title": "%command.openSettings%",
        "category": "%category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "claudeGroups.group.newSubgroup",
        "title": "%command.group.newSubgroup%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.moveToGroup",
        "title": "%command.group.moveToGroup%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.rename",
        "title": "%command.group.rename%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.setColor",
        "title": "%command.group.setColor%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.moveUp",
        "title": "%command.group.moveUp%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.moveDown",
        "title": "%command.group.moveDown%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.moveTop",
        "title": "%command.group.moveTop%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.moveBottom",
        "title": "%command.group.moveBottom%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.group.delete",
        "title": "%command.group.delete%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.open",
        "title": "%command.session.open%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.openInTerminal",
        "title": "%command.session.openInTerminal%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.moveToGroup",
        "title": "%command.session.moveToGroup%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.newGroupFromSelection",
        "title": "%command.session.newGroupFromSelection%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.removeFromGroup",
        "title": "%command.session.removeFromGroup%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.copyId",
        "title": "%command.session.copyId%",
        "category": "%category%"
      },
      {
        "command": "claudeGroups.session.reveal",
        "title": "%command.session.reveal%",
        "category": "%category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeGroups.newSession",
          "when": "view == claudeGroups.sessions",
          "group": "navigation@0"
        },
        {
          "command": "claudeGroups.newGroup",
          "when": "view == claudeGroups.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeGroups.collapseAll",
          "when": "view == claudeGroups.sessions",
          "group": "navigation@2"
        },
        {
          "command": "claudeGroups.refresh",
          "when": "view == claudeGroups.sessions",
          "group": "navigation@3"
        },
        {
          "command": "claudeGroups.expandAll",
          "when": "view == claudeGroups.sessions",
          "group": "1_view@1"
        },
        {
          "command": "claudeGroups.focusSearch",
          "when": "view == claudeGroups.sessions",
          "group": "1_view@2"
        },
        {
          "command": "claudeGroups.importFromClaude",
          "when": "view == claudeGroups.sessions",
          "group": "2_import@1"
        },
        {
          "command": "claudeGroups.openSettings",
          "when": "view == claudeGroups.sessions",
          "group": "3_settings@1"
        }
      ],
      "webview/context": [
        {
          "command": "claudeGroups.group.newSession",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group'",
          "group": "0_session@1"
        },
        {
          "command": "claudeGroups.group.newSubgroup",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group'",
          "group": "0_session@2"
        },
        {
          "command": "claudeGroups.newSession",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection != 'group' && webviewSection != 'session'",
          "group": "0_session@1"
        },
        {
          "command": "claudeGroups.session.open",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session'",
          "group": "1_open@1"
        },
        {
          "command": "claudeGroups.session.openInTerminal",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session'",
          "group": "1_open@2"
        },
        {
          "command": "claudeGroups.session.moveToGroup",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session'",
          "group": "2_group@1"
        },
        {
          "command": "claudeGroups.session.newGroupFromSelection",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session'",
          "group": "2_group@2"
        },
        {
          "command": "claudeGroups.session.removeFromGroup",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session' && grouped",
          "group": "2_group@3"
        },
        {
          "command": "claudeGroups.session.copyId",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session'",
          "group": "3_misc@1"
        },
        {
          "command": "claudeGroups.session.reveal",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'session'",
          "group": "3_misc@2"
        },
        {
          "command": "claudeGroups.group.rename",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group'",
          "group": "1_edit@1"
        },
        {
          "command": "claudeGroups.group.setColor",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group'",
          "group": "1_edit@2"
        },
        {
          "command": "claudeGroups.group.moveUp",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group' && canMoveUp",
          "group": "2_move@1"
        },
        {
          "command": "claudeGroups.group.moveDown",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group' && canMoveDown",
          "group": "2_move@2"
        },
        {
          "command": "claudeGroups.group.moveTop",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group' && canMoveUp",
          "group": "2_move@3"
        },
        {
          "command": "claudeGroups.group.moveBottom",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group' && canMoveDown",
          "group": "2_move@4"
        },
        {
          "command": "claudeGroups.group.moveToGroup",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group'",
          "group": "2_move@5"
        },
        {
          "command": "claudeGroups.newGroup",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection != 'session'",
          "group": "3_new@1"
        },
        {
          "command": "claudeGroups.group.delete",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection == 'group'",
          "group": "4_delete@1"
        },
        {
          "command": "claudeGroups.collapseAll",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection != 'session'",
          "group": "5_view@1"
        },
        {
          "command": "claudeGroups.expandAll",
          "when": "webviewId == 'claudeGroups.sessions' && webviewSection != 'session'",
          "group": "5_view@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeGroups.group.newSession",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.newSubgroup",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.moveToGroup",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.rename",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.setColor",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.moveUp",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.moveDown",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.moveTop",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.moveBottom",
          "when": "false"
        },
        {
          "command": "claudeGroups.group.delete",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.open",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.openInTerminal",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.moveToGroup",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.newGroupFromSelection",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.removeFromGroup",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.copyId",
          "when": "false"
        },
        {
          "command": "claudeGroups.session.reveal",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "claudeGroups.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "hu"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.hu%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "claudeGroups.showAccount": {
          "type": "boolean",
          "default": true,
          "description": "%config.showAccount.description%"
        },
        "claudeGroups.showLimits": {
          "type": "boolean",
          "default": true,
          "description": "%config.showLimits.description%"
        },
        "claudeGroups.itemPrefix": {
          "type": "string",
          "enum": [
            "tree",
            "bullet",
            "arrow",
            "dash",
            "number",
            "custom",
            "none"
          ],
          "enumDescriptions": [
            "%config.itemPrefix.tree%",
            "%config.itemPrefix.bullet%",
            "%config.itemPrefix.arrow%",
            "%config.itemPrefix.dash%",
            "%config.itemPrefix.number%",
            "%config.itemPrefix.custom%",
            "%config.itemPrefix.none%"
          ],
          "default": "tree",
          "description": "%config.itemPrefix.description%"
        },
        "claudeGroups.customPrefix": {
          "type": "string",
          "default": "»",
          "maxLength": 8,
          "description": "%config.customPrefix.description%"
        },
        "claudeGroups.itemIndent": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 64,
          "description": "%config.itemIndent.description%"
        },
        "claudeGroups.showIndentGuide": {
          "type": "boolean",
          "default": true,
          "description": "%config.showIndentGuide.description%"
        },
        "claudeGroups.showTimestamps": {
          "type": "boolean",
          "default": true,
          "description": "%config.showTimestamps.description%"
        },
        "claudeGroups.sessionOrder": {
          "type": "string",
          "enum": [
            "manual",
            "recent",
            "name"
          ],
          "enumDescriptions": [
            "%config.sessionOrder.manual%",
            "%config.sessionOrder.recent%",
            "%config.sessionOrder.name%"
          ],
          "default": "manual",
          "description": "%config.sessionOrder.description%"
        },
        "claudeGroups.ungroupedPosition": {
          "type": "string",
          "enum": [
            "bottom",
            "top",
            "hidden"
          ],
          "enumDescriptions": [
            "%config.ungroupedPosition.bottom%",
            "%config.ungroupedPosition.top%",
            "%config.ungroupedPosition.hidden%"
          ],
          "default": "bottom",
          "description": "%config.ungroupedPosition.description%"
        },
        "claudeGroups.openOnSingleClick": {
          "type": "boolean",
          "default": true,
          "description": "%config.openOnSingleClick.description%"
        },
        "claudeGroups.openWith": {
          "type": "string",
          "enum": [
            "auto",
            "panel",
            "terminal"
          ],
          "enumDescriptions": [
            "%config.openWith.auto%",
            "%config.openWith.panel%",
            "%config.openWith.terminal%"
          ],
          "default": "auto",
          "description": "%config.openWith.description%"
        },
        "claudeGroups.claudeCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.claudeCommand.description%"
        },
        "claudeGroups.claudeConfigDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.claudeConfigDir.description%"
        }
      }
    }
  }
}
